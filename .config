# This is an empty file, please overwrite it after generating the .config file with the source code
# Target System x86
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Base System
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# Docker 支持
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-docker=y

# iStore 商店
CONFIG_PACKAGE_luci-app-istorex=y

# PassWall & PassWall2 两套独立
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall2=y

# Lucky
CONFIG_PACKAGE_luci-app-lucky=y

# ddns‑go
CONFIG_PACKAGE_luci-app-ddns-go=y

# 微信推送 + 全能推送（两个不同插件）
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-pushd=y

# AList 文件列表
CONFIG_PACKAGE_luci-app-alist=y

# 易有云文件管理器
CONFIG_PACKAGE_luci-app-easycloud=y

# Turbo‑Acc 新版 流量加速
CONFIG_PACKAGE_luci-app-turboacc=y

# Samba4 局域网网络共享（硬盘共享给局域网设备）
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# 流量统计
CONFIG_PACKAGE_luci-app-nlbwmon=y

# IP限速 / QoS
CONFIG_PACKAGE_luci-app-qos=y
CONFIG_PACKAGE_luci-app-sqm=y

# 网络组件，静态IP原生支持，不需要额外包，luci自带

# 依赖库
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_mountd=y

# LuCI 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-docker-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-qos-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-alist-zh-cn=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
CONFIG_PACKAGE_luci-i18n-pushd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-istorex-zh-cn=y
CONFIG_PACKAGE_luci-i18n-easycloud-zh-cn=y
